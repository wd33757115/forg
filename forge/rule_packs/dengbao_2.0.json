{
  "module_id": "dengbao_2.0",
  "name": "网络安全等级保护 2.0",
  "version": "1.0.0",
  "description": "等保2.0核心控制项 — 技术与管理要求",
  "rules": [
    {
      "id": "db-acs-001",
      "title": "身份鉴别",
      "description": "应对登录用户进行身份标识和鉴别，身份标识具有唯一性",
      "category": "access_control",
      "severity": "critical",
      "checks": ["document:身份鉴别", "document:访问控制"],
      "references": ["GB/T 22239-2019 8.1.4.1"]
    },
    {
      "id": "db-aud-001",
      "title": "安全审计",
      "description": "应启用安全审计功能，审计覆盖到每个用户，审计记录应包括日期、时间、类型、主体、客体和结果",
      "category": "audit",
      "severity": "high",
      "checks": ["document:安全审计", "document:日志"],
      "references": ["GB/T 22239-2019 8.1.4.3"]
    },
    {
      "id": "db-bnd-001",
      "title": "边界防护",
      "description": "应保证跨越边界的访问和数据流通过边界设备提供的受控接口进行通信",
      "category": "network",
      "severity": "critical",
      "checks": ["document:边界", "document:防火墙"],
      "references": ["GB/T 22239-2019 8.1.2.1"]
    },
    {
      "id": "db-mgt-001",
      "title": "安全管理制度",
      "description": "应建立网络安全工作的总体方针和安全策略",
      "category": "management",
      "severity": "high",
      "checks": ["document:安全管理制度", "document:等保"],
      "references": ["GB/T 22239-2019 8.2.1.1"]
    }
  ]
}
