{
  "module_id": "itil_iso20000",
  "name": "ITIL 4 + ISO/IEC 20000",
  "version": "1.0.0",
  "description": "IT服务管理最佳实践与ISO20000核心要求",
  "rules": [
    {
      "id": "itil-inc-001",
      "title": "事件管理",
      "description": "所有服务中断或质量下降必须记录为事件并按优先级处理",
      "category": "incident",
      "severity": "high",
      "checks": ["document:事件", "document:incident"],
      "references": ["ITIL 4 Incident Management", "ISO/IEC 20000-1 8.6"]
    },
    {
      "id": "itil-prb-001",
      "title": "问题管理",
      "description": "反复发生的事件必须启动问题管理流程进行根因分析",
      "category": "problem",
      "severity": "medium",
      "checks": ["document:问题", "document:根因"],
      "references": ["ITIL 4 Problem Management", "ISO/IEC 20000-1 8.7"]
    },
    {
      "id": "itil-chg-001",
      "title": "变更管理",
      "description": "所有变更必须经过评估、授权和实施控制",
      "category": "change",
      "severity": "high",
      "checks": ["document:变更"],
      "references": ["ITIL 4 Change Enablement", "ISO/IEC 20000-1 8.5"]
    },
    {
      "id": "itil-cfg-001",
      "title": "配置管理",
      "description": "服务资产和配置项必须被识别、记录和控制",
      "category": "configuration",
      "severity": "medium",
      "checks": ["document:配置", "document:CMDB"],
      "references": ["ITIL 4 Service Configuration Management"]
    },
    {
      "id": "itil-slm-001",
      "title": "服务级别管理",
      "description": "必须定义、协商和监控服务级别协议(SLA)",
      "category": "service_level",
      "severity": "medium",
      "checks": ["document:SLA", "document:服务级别"],
      "references": ["ITIL 4 Service Level Management", "ISO/IEC 20000-1 8.3"]
    }
  ]
}
