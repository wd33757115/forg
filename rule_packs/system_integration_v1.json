{
  "pack_id": "system_integration_v1",
  "name": "系统集成 Rule Pack v1",
  "version": "1.0.0",
  "description": "系统集成行业默认规则包：base_si + 等保2.0 + ITIL/ISO20000",
  "enabled_modules": ["base_si", "dengbao_2.0", "itil_iso20000"],
  "modules": {
    "base_si": {
      "module_id": "base_si",
      "name": "系统集成基础规范",
      "version": "1.0.0",
      "description": "系统集成项目通用规则：WBS、交付物、接口管理、变更控制",
      "rules": [
        {
          "id": "si-wbs-001",
          "title": "WBS完整性",
          "description": "项目必须定义完整的WBS，覆盖需求、设计、实施、测试、验收各阶段",
          "category": "project_management",
          "severity": "high",
          "checks": [
            "wbs:requirements",
            "wbs:design",
            "wbs:implementation",
            "wbs:testing",
            "wbs:acceptance"
          ],
          "references": ["PMBOK WBS", "系统集成项目管理规范"]
        },
        {
          "id": "si-doc-001",
          "title": "核心交付文档",
          "description": "必须存在经审批的技术方案与验收报告",
          "category": "documentation",
          "severity": "high",
          "checks": ["document:技术方案", "document:验收"],
          "references": ["系统集成文档规范"]
        },
        {
          "id": "si-int-001",
          "title": "接口管理",
          "description": "所有外部系统接口必须有接口设计文档和联调记录",
          "category": "integration",
          "severity": "medium",
          "checks": ["document:接口"],
          "references": ["接口管理最佳实践"]
        },
        {
          "id": "si-chg-001",
          "title": "变更控制",
          "description": "重大变更必须经过变更评审并留存记录",
          "category": "change_management",
          "severity": "high",
          "checks": ["document:变更"],
          "references": ["变更管理流程"]
        },
        {
          "id": "si-test-001",
          "title": "测试与验收",
          "description": "必须完成系统集成测试（SIT）、用户验收测试（UAT）并留存测试报告",
          "category": "testing",
          "severity": "high",
          "checks": ["document:测试", "document:验收", "wbs:testing"],
          "references": ["系统集成测试规范"]
        },
        {
          "id": "si-sec-001",
          "title": "安全集成要求",
          "description": "集成方案须包含身份认证、传输加密、日志审计等安全设计",
          "category": "security",
          "severity": "high",
          "checks": ["document:安全", "document:等保"],
          "references": ["系统集成安全规范"]
        },
        {
          "id": "si-ops-001",
          "title": "运维移交",
          "description": "项目验收前须完成运维文档移交和知识转移",
          "category": "operations",
          "severity": "medium",
          "checks": ["document:运维", "document:移交"],
          "references": ["运维移交 checklist"]
        }
      ]
    },
    "dengbao_2.0": {
      "module_id": "dengbao_2.0",
      "name": "网络安全等级保护 2.0",
      "version": "1.0.0",
      "description": "等保2.0核心控制项 — 技术与管理要求",
      "rules": [
        {
          "id": "db-acs-001",
          "title": "身份鉴别",
          "description": "应对登录用户进行身份标识和鉴别，身份标识具有唯一性",
          "category": "access_control",
          "severity": "critical",
          "checks": ["document:身份鉴别", "document:访问控制"],
          "references": ["GB/T 22239-2019 8.1.4.1"]
        },
        {
          "id": "db-aud-001",
          "title": "安全审计",
          "description": "应启用安全审计功能，审计覆盖到每个用户",
          "category": "audit",
          "severity": "high",
          "checks": ["document:安全审计", "document:日志"],
          "references": ["GB/T 22239-2019 8.1.4.3"]
        },
        {
          "id": "db-bnd-001",
          "title": "边界防护",
          "description": "应保证跨越边界的访问和数据流通过边界设备提供的受控接口进行通信",
          "category": "network",
          "severity": "critical",
          "checks": ["document:边界", "document:防火墙"],
          "references": ["GB/T 22239-2019 8.1.2.1"]
        },
        {
          "id": "db-mgt-001",
          "title": "安全管理制度",
          "description": "应建立网络安全工作的总体方针和安全策略",
          "category": "management",
          "severity": "high",
          "checks": ["document:安全管理制度", "document:等保"],
          "references": ["GB/T 22239-2019 8.2.1.1"]
        },
        {
          "id": "db-dat-001",
          "title": "数据备份与恢复",
          "description": "应提供重要数据的本地数据备份与恢复功能",
          "category": "data_security",
          "severity": "high",
          "checks": ["document:备份", "document:恢复"],
          "references": ["GB/T 22239-2019 8.1.4.6"]
        },
        {
          "id": "db-mal-001",
          "title": "恶意代码防范",
          "description": "应安装防恶意代码软件，并及时更新",
          "category": "host_security",
          "severity": "high",
          "checks": ["document:防病毒", "document:恶意代码"],
          "references": ["GB/T 22239-2019 8.1.4.4"]
        },
        {
          "id": "db-cry-001",
          "title": "数据加密",
          "description": "应采用密码技术保证重要数据在传输和存储过程中的保密性",
          "category": "data_security",
          "severity": "critical",
          "checks": ["document:加密", "document:TLS"],
          "references": ["GB/T 22239-2019 8.1.4.5 c)"]
        }
      ]
    },
    "itil_iso20000": {
      "module_id": "itil_iso20000",
      "name": "ITIL 4 + ISO/IEC 20000",
      "version": "1.0.0",
      "description": "IT服务管理最佳实践与ISO20000核心要求",
      "rules": [
        {
          "id": "itil-inc-001",
          "title": "事件管理",
          "description": "所有服务中断或质量下降必须记录为事件并按优先级处理",
          "category": "incident",
          "severity": "high",
          "checks": ["document:事件", "document:incident"],
          "references": ["ITIL 4 Incident Management", "ISO/IEC 20000-1 8.6"]
        },
        {
          "id": "itil-prb-001",
          "title": "问题管理",
          "description": "反复发生的事件必须启动问题管理流程进行根因分析",
          "category": "problem",
          "severity": "medium",
          "checks": ["document:问题", "document:根因"],
          "references": ["ITIL 4 Problem Management", "ISO/IEC 20000-1 8.7"]
        },
        {
          "id": "itil-chg-001",
          "title": "变更管理",
          "description": "所有变更必须经过评估、授权和实施控制",
          "category": "change",
          "severity": "high",
          "checks": ["document:变更"],
          "references": ["ITIL 4 Change Enablement", "ISO/IEC 20000-1 8.5"]
        },
        {
          "id": "itil-cfg-001",
          "title": "配置管理",
          "description": "服务资产和配置项必须被识别、记录和控制",
          "category": "configuration",
          "severity": "medium",
          "checks": ["document:配置", "document:CMDB"],
          "references": ["ITIL 4 Service Configuration Management"]
        },
        {
          "id": "itil-slm-001",
          "title": "服务级别管理",
          "description": "必须定义、协商和监控服务级别协议(SLA)",
          "category": "service_level",
          "severity": "medium",
          "checks": ["document:SLA", "document:服务级别"],
          "references": ["ITIL 4 Service Level Management", "ISO/IEC 20000-1 8.3"]
        },
        {
          "id": "itil-rel-001",
          "title": "发布管理",
          "description": "软件/配置发布必须经过测试验证和发布审批",
          "category": "release",
          "severity": "medium",
          "checks": ["document:发布", "document:release"],
          "references": ["ITIL 4 Release Management"]
        },
        {
          "id": "itil-ava-001",
          "title": "可用性管理",
          "description": "应定义服务可用性目标并持续监控",
          "category": "availability",
          "severity": "medium",
          "checks": ["document:可用性", "document:availability"],
          "references": ["ITIL 4 Availability Management"]
        },
        {
          "id": "itil-km-001",
          "title": "知识管理",
          "description": "事件/问题解决方案应沉淀到知识库",
          "category": "knowledge",
          "severity": "low",
          "checks": ["document:知识库"],
          "references": ["ITIL 4 Knowledge Management"]
        }
      ]
    }
  }
}
