# Copy to .env and fill in values (never commit .env)

# --- LLM provider (deepseek | openai | aliyun | volcengine) ---
FORGE_LLM_PROVIDER=deepseek
# FORGE_LLM_MODEL=deepseek-chat
# FORGE_LLM_TEMPERATURE=0.3
# FORGE_LLM_MAX_RETRIES=3
# FORGE_LLM_RETRY_DELAY=1.0
# FORGE_LLM_TIMEOUT=120
# Structured output: auto | json_schema | function_calling | json_prompt
# DeepSeek v4+ requires json_prompt (default auto picks this for deepseek)
# FORGE_LLM_STRUCTURED_MODE=json_prompt

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI / generic compatible endpoint
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Aliyun DashScope (OpenAI-compatible mode)
# DASHSCOPE_API_KEY=sk-your-key-here

# Volcengine Ark
# VOLC_API_KEY=your-ark-api-key
# ARK_API_KEY=your-ark-api-key

# Logging
FORGE_LOG_LEVEL=INFO

# CLI: set to any value to disable colored output
# NO_COLOR=1

# Web server (when using --web)
# FORGE_WEB_HOST=127.0.0.1
# FORGE_WEB_PORT=8000
