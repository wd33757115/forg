# Copy to .env and fill in values (never commit .env)

# LLM — DeepSeek API (OpenAI-compatible). Optional: without key, heuristic mode is used.
DEEPSEEK_API_KEY=sk-your-key-here

# Alternative key name supported by forge.utils.llm
# OPENAI_API_KEY=sk-your-key-here

# Logging
FORGE_LOG_LEVEL=INFO

# CLI: set to any value to disable colored output
# NO_COLOR=1

# Web server (when using --web)
# FORGE_WEB_HOST=127.0.0.1
# FORGE_WEB_PORT=8000
